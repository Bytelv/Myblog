# Cloudflare Pages 缓存策略（由 tools/gen-headers.js 生成）
# 写法见官方文档 /pages/configuration/headers/：
#   - 命中多条规则会继承全部头；同名头二次出现会逗号拼接
#   - 因此每条规则只设一次 Cache-Control，且先 "! Cache-Control" 删除默认值

# HTML（所有带 / 的路径 + 根）：不缓存，每次回源验证
# 用 ! Cache-Control 先删掉 Pages 对 HTML 的默认短缓存，再设 no-cache
/
  ! Cache-Control
  Cache-Control: no-cache, max-age=0, must-revalidate

/*.html
  ! Cache-Control
  Cache-Control: no-cache, max-age=0, must-revalidate

# 静态资源：先删默认 immutable，再显式设 immutable（语义清晰、单值）
/css/*
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable
/js/*
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable
/images/*
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable
/*.woff2
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable
/*.woff
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable
/*.svg
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable
